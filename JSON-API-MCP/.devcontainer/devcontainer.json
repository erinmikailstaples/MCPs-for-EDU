{
  "name": "Jeopardy JSON to MCP",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "onCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && sudo apt-get update && sudo apt-get install -y jq",
  "postCreateCommand": "$HOME/.local/bin/uv sync --locked",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Jeopardy FastAPI",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "GitHub.copilot-chat"
      ]
    }
  }
}
