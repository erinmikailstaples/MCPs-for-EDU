{
  "name": "Developer education MCP workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "onCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh",
  "postCreateCommand": "$HOME/.local/bin/uv sync --locked --directory JSON-API-MCP",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "GitHub.copilot-chat"]
    }
  }
}
